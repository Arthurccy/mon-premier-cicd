{
  "name": "mon-premier-cicd",
  "version": "1.0.0",
  "description": "Premier pipeline CI/CD avec GitHub Actions, Node.js, Jest et ESLint.",
  "main": "src/calculator.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix"
  },
  "keywords": [
    "ci",
    "cd",
    "github-actions",
    "jest",
    "eslint"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
